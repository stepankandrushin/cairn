// The settings every target shares. Local.xcconfig, which git leaves out, holds this Mac's: the team
// that signs (CAIRN_IOS_TEAM) and the server the Photos extension may upload to
// (CAIRN_UPLOAD_URL_BASE). Copy Local.xcconfig.example to start one.

CAIRN_IOS_TEAM =
CAIRN_UPLOAD_URL_BASE = https:/$()/localhost
CAIRN_VERSION = 0.1.27
CAIRN_BUILD = 1

#include? "Local.xcconfig"

DEVELOPMENT_TEAM = $(CAIRN_IOS_TEAM)
CODE_SIGN_STYLE = Automatic
MARKETING_VERSION = $(CAIRN_VERSION)
CURRENT_PROJECT_VERSION = $(CAIRN_BUILD)
IPHONEOS_DEPLOYMENT_TARGET = 26.4
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = minimal
OTHER_LDFLAGS = $(inherited) -framework Security -framework SystemConfiguration
ENABLE_USER_SCRIPT_SANDBOXING = YES
CLANG_ENABLE_MODULES = YES
GENERATE_INFOPLIST_FILE = YES
