{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cairn Tray",
  "version": "0.1.22",
  "identifier": "com.cairn.tray",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
